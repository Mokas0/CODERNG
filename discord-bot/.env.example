# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# Discord bot token — from https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# ID of the text channel where Jerry should announce rare rolls
# Right-click the channel in Discord (with Developer Mode on) → Copy Channel ID
DISCORD_CHANNEL_ID=your-channel-id-here

# Supabase project credentials — same values as your .env.local
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
